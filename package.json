{
  "name": "dj-graphyla",
  "private": true,
  "version": "0.7.0",
  "description": "A DJ transition graph: songs are nodes, mixes are directed edges, a set is a walk.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:y2k": "node tools/y2k-art/render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "cytoscape": "^3.34.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
